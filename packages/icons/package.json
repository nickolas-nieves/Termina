{
  "name": "termina-icons",
  "version": "0.1.0",
  "description": "Termina \u2014 pixel icons drawn on a 13\u00d713 grid. Raw SVG, an SVG sprite, and tree-shakeable React components.",
  "license": "MIT",
  "author": "Nickolas Nieves",
  "homepage": "https://github.com/nickolas-nieves/Termina#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickolas-nieves/Termina.git",
    "directory": "packages/icons"
  },
  "bugs": "https://github.com/nickolas-nieves/Termina/issues",
  "keywords": [
    "icons",
    "svg",
    "pixel",
    "pixel-art",
    "react",
    "icon-set",
    "termina"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./icons.json": "./dist/icons.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./svg/*": "./dist/svg/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit dist/index.d.ts dist/react.d.ts",
    "prepublishOnly": "node scripts/build.mjs && node scripts/verify.mjs"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@termina/glyph": "*",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
