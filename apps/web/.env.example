# Copy to apps/web/.env.local and fill in. Nothing here is needed just to run
# `npm run dev` and draw glyphs — only the admin console and publishing use it.

# ── Sessions ────────────────────────────────────────────────
# Signs the admin session cookie. Required in production; the app refuses to
# start without it rather than falling back to something guessable.
#   openssl rand -base64 48
SESSION_SECRET=

# ── Admin sign-in ───────────────────────────────────────────
# Comma-separated GitHub logins allowed into /admin. Empty means nobody,
# which is the safe default for a fork.
ADMIN_GITHUB_LOGINS=

# From the GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Authorization callback URL must be <site>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Publishing ──────────────────────────────────────────────
# Where "Publish" commits the icon set. The signed-in admin's GitHub account
# needs push access to it.
GITHUB_REPO=nickolas-nieves/Termina
GITHUB_BRANCH=main

# ── Site ────────────────────────────────────────────────────
# The canonical origin. Used for the OAuth redirect, canonical URLs and the
# sitemap. Set this in production: without it the OAuth redirect falls back to
# the request's Host header, which a client can forge.
PUBLIC_SITE_URL=http://localhost:3000
